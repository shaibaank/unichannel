# ──────────────────────────────────────────────
# OmniInbox environment configuration
# Copy to `.env` and fill in real values.
# ──────────────────────────────────────────────

# ── Evolution API (WhatsApp / Baileys) ──
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=change_me_evolution_key
EVOLUTION_INSTANCE_NAME=omni-inbox
# Evolution (Docker) calls this URL to deliver inbound messages.
# Dev (backend on host): http://host.docker.internal:3001/webhook/whatsapp
# Full compose (backend as a service): http://backend:3001/webhook/whatsapp
WHATSAPP_WEBHOOK_URL=http://backend:3001/webhook/whatsapp

# ── Email (IMAP in / SMTP out) ──
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USER=your@gmail.com
EMAIL_PASS=app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Twilio (SMS, optional) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── LLM via OpenRouter (primary) with Groq fallback ──
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Optional fallback — used automatically if OpenRouter errors.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# ── Database ──
DATABASE_URL=postgresql://postgres:secret@postgres:5432/omni_inbox?schema=public

# ── Redis ──
REDIS_URL=redis://redis:6379

# ── Auth ──
JWT_SECRET=change_me_long_random_secret

# ── App ──
AUTO_REPLY_ENABLED=false
LLM_SYSTEM_PROMPT="You are a helpful customer support agent. Be concise, friendly, and professional."
BACKEND_PORT=3001
FRONTEND_PORT=3000
PUBLIC_BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ── Frontend (Next.js public vars) ──
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
